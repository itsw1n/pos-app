# Seed-only secrets — NEVER commit this file or ship it to the app.
# Used by scripts/seed.cjs to apply the schema and create auth users.
# Put this in the environment of your CI / machine, never in app source.

# Postgres connection string of the Supabase dev database
# (Project settings -> Database -> Connection string -> URI).
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Service role key — has full DB + Auth admin access. Use ONLY on a backend.
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
