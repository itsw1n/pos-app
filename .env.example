# Variable inventory only. Do not copy this file for normal development:
# `make dev` injects local values from `supabase status`, while preview and
# production values belong in their matching EAS environments.
EXPO_PUBLIC_SUPABASE_URL=https://your-hosted-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-hosted-anon-key
EXPO_PUBLIC_APP_ENV=preview
