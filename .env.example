# App runtime — copy to .env.development / .env.production and fill with your
# Supabase project's ANON (public) key. These are EXPO_PUBLIC because the app
# needs them at build/runtime inside Expo Go.
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# Optional: switch per environment (development|production).
EXPO_PUBLIC_APP_ENV=development
