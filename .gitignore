# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Local env files. Development is injected from `supabase status`, while
# hosted builds use EAS environments.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# editor / scratch
.vscode/
.superpowers/
docs/superpowers/

# planning scratch docs (never committed)
.opencode/plans/

# Supabase CLI link cache
supabase/.temp/
supabase/.branches/

# editor lock files
.~lock.*#
